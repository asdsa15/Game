# 问道长生 · 环境变量声明（唯一清单）
#
# 约定：本文件与 apps/api/src/env.ts 的 zod Schema 一一对应。
# 新增变量必须两边同时改；不在本文件声明的变量，CI 不予注入。
#
# 本地开发**不需要**复制成 .env：所有键都有默认值，`npm run dev` 直接起。
# 只有要改端口 / 换真 Postgres / 部署时才需要。

# ---- 运行 ----
NODE_ENV=development            # development | test | production
HOST=127.0.0.1
PORT=8787

# ---- 数据库 ----
DB_DRIVER=pglite                # pglite（默认，进程内 WASM，数据落本地） | postgres
PGLITE_DIR=./data/pg            # pglite 数据目录；填 memory 则每次启动清空
# DATABASE_URL=postgres://user:pass@127.0.0.1:5432/wendao   # DB_DRIVER=postgres 时必填

# ---- 身份 ----
# 至少 32 字符。生产环境若仍是下面这个开发默认值，服务启动即拒。
JWT_SECRET=wendao-local-dev-secret-0123456789abcdef
ACCESS_TTL=900                  # 秒，access token 15 分钟（只放前端内存）
REFRESH_TTL=2592000             # 秒，refresh 30 天（httpOnly cookie）

# ---- 传输 ----
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false             # 上 HTTPS 时改 true
BODY_LIMIT=2097152              # 2 MiB
SAVE_BYTES_MAX=524288           # 单个存档上限 512 KiB

# ---- 内容与内核（P1 起使用；内容包构建时读取）----
# CONTENT_VERSION=0.1.0         # 缺省由 packages/content 生成，覆盖仅在灰度时用
