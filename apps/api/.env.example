# 复制为 .env 后按需修改。.env 不入库。
NODE_ENV=development
HOST=127.0.0.1
PORT=8787

# 本机 docker compose 起的库；生产换成托管地址，注意加 ?sslmode=require
DATABASE_URL=postgres://wendao:wendao@127.0.0.1:5432/wendao

# 至少 32 字符。生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

# 令牌有效期（秒）：access 15 分钟 / refresh 30 天
ACCESS_TTL=900
REFRESH_TTL=2592000

# 允许的前端来源，逗号分隔（Vite 开发端口 / 线上域名）
CORS_ORIGINS=http://localhost:5173

# 线上必须 true（HTTPS 才下发 cookie）
COOKIE_SECURE=false

# 请求体与存档体积上限（字节）
BODY_LIMIT=2097152
SAVE_BYTES_MAX=524288
