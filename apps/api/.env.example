# 复制为 .env 才生效；不复制也能跑（下面都是默认值）。
NODE_ENV=development
HOST=127.0.0.1
PORT=8787

# 库：默认 pglite（进程内真 Postgres，数据落 PGLITE_DIR）；要接真库改 postgres 并填 DATABASE_URL
DB_DRIVER=pglite
PGLITE_DIR=./data/pg
# DATABASE_URL=postgres://user:pass@127.0.0.1:5432/wendao

# 本地开发有默认值；生产环境必须换（否则启动就报错）
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET=

ACCESS_TTL=900
REFRESH_TTL=2592000
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
BODY_LIMIT=2097152
SAVE_BYTES_MAX=524288
